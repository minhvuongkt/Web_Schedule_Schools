# =============================================================================
# Environment configuration — copy to .env and fill in real values.
#   Local dev:  cp .env.example .env  (defaults work with scripts/db.ts)
#   Production: see docs/deployment.md (Docker compose reads this file too)
# =============================================================================

# --- Database -----------------------------------------------------------------
# Connection string the app uses (src/server/db.ts).
# Local dev: embedded PostgreSQL started by `npm run db:start` (scripts/db.ts).
# Production: your managed instance, e.g.
#   postgresql://school:<strong-password>@db:5432/school_timetable   (compose)
DATABASE_URL="postgresql://postgres:postgres@localhost:5435/school_timetable"

# Embedded dev cluster settings (must match DATABASE_URL; production ignores
# these — the compose stack uses the POSTGRES_* variables below).
PG_PORT=5435
PG_USER=postgres
PG_PASSWORD=postgres
PG_DATABASE=school_timetable
PG_DATA_DIR=.pgdata-fresh

# --- Docker compose (production) ----------------------------------------------
# Used by docker-compose.yml. POSTGRES_PASSWORD is required.
#POSTGRES_USER=school
#POSTGRES_PASSWORD=<strong-db-password>
#POSTGRES_DB=school_timetable
#APP_PORT=3000

# --- Web Push notifications (VAPID) -------------------------------------------
# Generate once: npm run vapid:generate
# The public key is also embedded in the client (src/lib/push.ts reads it from
# the server); keep the private key secret.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:tkb@example.edu.vn

# --- Optional build overrides ---------------------------------------------------
# NEXT_DIST_DIR=.next          # revert to default distDir once stale dir gone
